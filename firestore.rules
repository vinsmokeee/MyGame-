rules_version = '2';
// Security rules for Lucky Spin's online features. Paste into the Firebase console:
// Firestore Database > Rules, then Publish.
service cloud.firestore {
  match /databases/{database}/documents {
    function isAdmin() {
      return request.auth != null && request.auth.uid == 'eL6ulQJzvvSFt1flDcdM7FMsYUJ2';
    }
    function isOwner(uid) {
      return request.auth != null && request.auth.uid == uid;
    }
    function optString(data, key, max) {
      return !(key in data) || (data[key] is string && data[key].size() <= max);
    }

    // Player ID numbers: ids/{6-digit number} -> { uid }. A number can be claimed
    // only if nobody has it yet (creating an existing document counts as an update).
    match /ids/{idNumber} {
      allow read: if isAdmin();
      allow create: if request.auth != null
        && idNumber.matches('^[1-9][0-9]{5}$')
        && request.resource.data.keys().hasOnly(['uid'])
        && request.resource.data.uid == request.auth.uid;
    }

    // Each player's account (progress, name, balance), also readable by the owner: players/{auth uid}
    match /players/{uid} {
      allow read: if isAdmin() || isOwner(uid);
      allow create, update: if isOwner(uid)
        && request.resource.data.keys().hasOnly(['name', 'username', 'gender', 'playerId', 'nu', 'best', 'spins',
                                                  'drops', 'crosses', 'minesPlayed', 'history', 'grants', 'prizeNoteSeen', 'deviceId', 'updatedAt',
                                                  'joinedAt'])
        && optString(request.resource.data, 'name', 20)
        && optString(request.resource.data, 'username', 20)
        && optString(request.resource.data, 'gender', 20)
        && optString(request.resource.data, 'deviceId', 40)
        && (!('history' in request.resource.data) || (request.resource.data.history is list
            && request.resource.data.history.size() <= 40))
        && (!('grants' in request.resource.data) || (request.resource.data.grants is list
            && request.resource.data.grants.size() <= 500))
        && optString(request.resource.data, 'playerId', 12);

      // Nu added (positive amount) or deducted (negative amount) by the owner.
      // Only the owner can create them; the player's game removes each one once applied.
      match /grants/{grantId} {
        allow read, delete: if isAdmin() || isOwner(uid);
        allow create: if isAdmin()
          && request.resource.data.keys().hasOnly(['amount', 'createdAt'])
          && request.resource.data.amount is int
          && request.resource.data.amount != 0
          && request.resource.data.amount >= -1000000000
          && request.resource.data.amount <= 1000000000;
      }
    }

    // One welcome gift per phone: the first account made on a phone is recorded here.
    match /devices/{deviceId} {
      allow read: if request.auth != null;
      allow create: if request.auth != null
        && deviceId.size() <= 40
        && request.resource.data.keys().hasOnly(['uid', 'username', 'createdAt'])
        && request.resource.data.uid == request.auth.uid
        && optString(request.resource.data, 'username', 20)
        && request.resource.data.createdAt == request.time;
    }

    // Real player count shown in the lobby. New accounts add 1; the owner page sets the true total.
    match /stats/players {
      allow read: if request.auth != null;
      allow create, update: if request.auth != null
        && request.resource.data.keys().hasOnly(['count'])
        && request.resource.data.count is int
        && (isAdmin()
            || (resource == null && request.resource.data.count == 1)
            || (resource != null && request.resource.data.count == resource.data.count + 1));
    }

    // Big-win announcements shown to other players for a few seconds.
    match /wins/{winId} {
      allow read: if request.auth != null;
      allow create: if request.auth != null
        && request.resource.data.uid == request.auth.uid
        && request.resource.data.keys().hasOnly(['uid', 'name', 'playerId', 'game', 'label', 'amount', 'createdAt'])
        && optString(request.resource.data, 'name', 20)
        && optString(request.resource.data, 'playerId', 12)
        && optString(request.resource.data, 'game', 20)
        && optString(request.resource.data, 'label', 20)
        && request.resource.data.amount is int
        && request.resource.data.amount > 0 && request.resource.data.amount <= 1000000
        && request.resource.data.createdAt == request.time;
    }

    // One chat per player: chats/{player's auth uid}
    match /chats/{uid} {
      allow read: if isAdmin() || isOwner(uid);
      allow create, update: if (isAdmin() || isOwner(uid))
        && request.resource.data.keys().hasOnly(['playerId', 'name', 'lastMessage', 'updatedAt', 'unread', 'playerUnread'])
        && optString(request.resource.data, 'lastMessage', 200)
        && optString(request.resource.data, 'playerId', 12)
        && optString(request.resource.data, 'name', 20);

      match /messages/{messageId} {
        allow read: if isAdmin() || isOwner(uid);
        allow create: if ((isAdmin() && request.resource.data.from == 'admin')
                          || (isOwner(uid) && request.resource.data.from == 'player'))
          && request.resource.data.keys().hasOnly(['from', 'text', 'image', 'createdAt'])
          && optString(request.resource.data, 'text', 500)
          && optString(request.resource.data, 'image', 950000)
          && (('text' in request.resource.data && request.resource.data.text.size() > 0)
              || 'image' in request.resource.data)
          && request.resource.data.createdAt == request.time;
        // A new player's game adds the team's automatic welcome message (this exact text only).
        allow create: if isOwner(uid)
          && request.resource.data.keys().hasOnly(['from', 'text', 'createdAt'])
          && request.resource.data.from == 'admin'
          && request.resource.data.text == 'Kuzuzangpo and welcome to SOMA Games! 🙏 Feel free to chat and connect with us if you have any inquiries.'
          && request.resource.data.createdAt == request.time;
        // The owner can delete messages and photos they sent by hand (e.g. to the wrong player).
        // Recharge records ("Recharge of Nu X successfully added") are kept as history.
        allow delete: if isAdmin() && resource.data.from == 'admin'
          && (!('text' in resource.data) || !resource.data.text.matches('^Recharge of Nu [0-9,]+ successfully added$'));
      }
    }
  }
}
